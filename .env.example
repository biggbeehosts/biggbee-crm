# ── Data mode ────────────────────────────────────────────────────────────────
# mock   → realistic sample data, no credentials needed (default when credentials are missing)
# sheets → live Google Sheets (requires the GOOGLE_* variables below)
# Unset  → auto-detect: sheets if credentials are present, mock otherwise.

DATA_MODE=mock

# ── Google Sheets (service account) ─────────────────────────────────────────
# Leave all four empty to run in MOCK MODE (realistic sample data, no credentials needed).
#
# To connect the live sheet:
#   1. Create a Google Cloud service account and enable the Google Sheets API.
#   2. Create a JSON key for it. Copy the values below from that JSON file.
#   3. Share the spreadsheet with the service account's email (Viewer is enough for v1).
#
# GOOGLE_PRIVATE_KEY must keep its \n escapes exactly as they appear in the JSON key —
# the app converts them back to real newlines at runtime.

GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ── n8n automation (webhooks) ────────────────────────────────────────────────
# The CRM only TRIGGERS workflows and displays status -- all business logic stays in n8n.
# Each webhook may be a full URL, or a path joined onto N8N_BASE_URL.
# Leave any entry empty and its button will honestly report "Webhook not configured".
#
# N8N_API_KEY (optional) is sent as both `Authorization: Bearer <key>` and `X-API-KEY`
# headers, covering n8n's common Header Auth setups.
#
# For long-running workflows, set the n8n Webhook node to "Respond immediately" --
# the CRM waits at most 30 seconds for a response.

N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_RUN_CAMPAIGN=
N8N_WEBHOOK_PAUSE_CAMPAIGN=
N8N_WEBHOOK_RESUME_CAMPAIGN=
N8N_WEBHOOK_REFRESH_KB=
N8N_WEBHOOK_RETRY_FAILED=
# Optional status workflow: should return JSON like
# { "state": "running|idle|failed", "lastRun": "...", "currentJob": "...", "currentLead": "...",
#   "lastSuccess": "...", "averageRuntimeSeconds": 90, "queueSize": 12 }
N8N_WEBHOOK_STATUS=
# Reserved for a future n8n-side sync workflow (the Sync CRM button is local-only today).
N8N_WEBHOOK_SYNC=

# ── Workflow Control (System > Workflow Control page) ───────────────────────
# The single n8n workflow ID that runs Outreach/Status/Knowledge Base/Reply Processing today
# (the "Outbound Cold Email System" workflow) -- also what N8N_ADMIN_API_KEY's pause/resume and
# the Dashboard Automation card's status polling operate on. Find it in n8n's URL bar when the
# workflow is open: https://your-n8n/workflow/<THIS_ID>.
N8N_WORKFLOW_ID=
# Disabled by default on purpose (Part F of Change 4) -- only set to true when you intend to use
# the Advanced Workflow Update section (import/compare/deploy-as-new-version). Never required for
# normal scraper/campaign configuration changes.
# ADVANCED_WORKFLOW_UPDATES_ENABLED=true

# ── Optional: override sheet tab names if your spreadsheet uses different ones ──
# SHEET_TAB_LEADS=Leads
# SHEET_TAB_LEAD_MEMORY=Lead_Memory
# SHEET_TAB_DEMO_LIBRARY=Demo_Library
# SHEET_TAB_ERRORS=Errors
# SHEET_TAB_KB_CACHE=KB_Cache
# SHEET_TAB_UNKNOWN_SENDERS=Unknown_Senders

# ── n8n admin API (optional) — server-side only, powers real workflow status/pause/resume ────
# N8N_ADMIN_API_KEY=

# ── Admin authentication ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32. Required to run the app at all (session cookies).
AUTH_SECRET=

# Optional non-interactive bootstrap -- if unset, visit /setup on first run to create the admin
# account interactively (recommended for local dev too).
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# ── Local CRM data directory (campaigns, admin account, sessions, audit log) ─────────────────
# Defaults to ./data (gitignored) for local dev.
# LOCAL_DATA_DIR=

# ── Website Redesign Outreach (optional side feature) ────────────────────────────────────────
# Completely separate from the general campaign settings above: its OWN n8n webhook, Google Sheet
# and Drive folder. Nothing here falls back to N8N_WEBHOOK_RUN_CAMPAIGN or GOOGLE_SHEET_ID. All
# values are server-side only. See docs/website-redesign-outreach.md. Leave blank until supplied.
#
# Which workspace this configuration belongs to (every other workspace sees the feature as "not set up").
# REDESIGN_WORKSPACE_ID=biggbee
# The dedicated workflow's webhook: path (joined onto N8N_BASE_URL) or full URL. Suggested path
# for the imported workflow: webhook/biggbee/website-redesign/start
N8N_WEBHOOK_REDESIGN=
# The dedicated redesign spreadsheet (NOT the general CRM sheet) and its tabs.
REDESIGN_SHEET_ID=
REDESIGN_SHEET_LEADS_TAB=
REDESIGN_SHEET_TRACKING_TAB=
# The Drive main folder; each business has its own subfolder of screenshots directly inside it.
REDESIGN_DRIVE_FOLDER_ID=
# Maps the workflow's logical fields to the redesign sheet's real header names, as JSON.
# Required: businessName, email. Optional: businessId, businessType, website, driveFolderId,
# folderName, status, verifiedPreserved, bookingFormIncluded, unsubscribed.
# Example: {"businessName":"Business","email":"Email","businessType":"Type"}
REDESIGN_SHEET_COLUMNS=
# Optional: comma-separated values of the mapped "status" column that make a row eligible.
# REDESIGN_ELIGIBLE_STATUSES=
# Optional dedicated read-only service account for the CRM's status/scan preview (defaults to GOOGLE_CLIENT_EMAIL/GOOGLE_PRIVATE_KEY).
# REDESIGN_GOOGLE_CLIENT_EMAIL=
# REDESIGN_GOOGLE_PRIVATE_KEY=
# Your email provider's VERIFIED sending limits -- required before any live send. Campaign limits can only go below these.
REDESIGN_PROVIDER_HOURLY_LIMIT=
REDESIGN_PROVIDER_DAILY_LIMIT=
# Optional tuning (defaults shown): pacing, caps, safety thresholds.
# REDESIGN_DELAY_SECONDS=120
# REDESIGN_HOURLY_LIMIT=
# REDESIGN_DAILY_LIMIT=
# REDESIGN_MAX_PER_RUN=50
# REDESIGN_MAX_SCREENSHOTS=4
# REDESIGN_MAX_FILE_BYTES=4194304
# REDESIGN_MAX_TOTAL_BYTES=10485760
# REDESIGN_IGNORE_NON_IMAGE_FILES=false
# REDESIGN_BOUNCE_RATE_THRESHOLD=0.05
# REDESIGN_MIN_BOUNCE_SAMPLE=20
# REDESIGN_MAX_CONSECUTIVE_ERRORS=3
