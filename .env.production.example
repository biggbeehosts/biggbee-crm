# Production runtime environment for the Biggbee CRM container.
# Copy to .env.production (gitignored) and fill in real values -- never commit this file.
# Loaded into the container via docker-compose.yml's `env_file:`. No value here is ever
# baked into the Docker image (see Dockerfile / .dockerignore).
#
# This mirrors .env.example (used for local dev) -- see that file's comments for the full
# walkthrough on obtaining each value. Only the values that actually matter in production
# are listed here; everything else keeps its documented default/optional behavior.

# ── Data source ──────────────────────────────────────────────────────────────
# Production should read the real spreadsheet, not sample data.
DATA_MODE=sheets

# ── Google Sheets (service account) — REQUIRED in production ────────────────
# GOOGLE_PRIVATE_KEY must keep its \n escapes exactly as they appear in the service account's
# JSON key file -- the app converts them back to real newlines at runtime. Quote the value.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=

# ── n8n automation (webhooks) — REQUIRED in production ───────────────────────
# The CRM only triggers workflows and displays status; all business logic stays in n8n.
N8N_WEBHOOK_RUN_CAMPAIGN=

# Sent as both `Authorization: Bearer <key>` and `X-API-KEY` -- set this once the n8n webhook
# has Header Auth configured (see README → Production Setup Checklist, step 11). Without it the
# webhook is unauthenticated.
N8N_API_KEY=

# ── n8n automation (webhooks) — optional, stay "Not connected" in the UI until set ──
# N8N_BASE_URL=
# N8N_WEBHOOK_PAUSE_CAMPAIGN=
# N8N_WEBHOOK_RESUME_CAMPAIGN=
# N8N_WEBHOOK_REFRESH_KB=
# N8N_WEBHOOK_RETRY_FAILED=
# N8N_WEBHOOK_STATUS=
# N8N_WEBHOOK_SYNC=

# ── Optional: override sheet tab names if the spreadsheet uses different ones ──
# SHEET_TAB_LEADS=Leads
# SHEET_TAB_LEAD_MEMORY=Lead_Memory
# SHEET_TAB_DEMO_LIBRARY=Demo_Library
# SHEET_TAB_ERRORS=Errors
# SHEET_TAB_KB_CACHE=KB_Cache
# SHEET_TAB_UNKNOWN_SENDERS=Unknown_Senders

# ── n8n admin API (optional) — server-side only, powers real workflow status/pause/resume ────
# Settings → n8n API → Create an API key, inside n8n. Never exposed to the browser. Without it,
# the Automation card's status/pause/resume controls stay honestly disabled.
# N8N_ADMIN_API_KEY=
# The workflow to report status for / pause-resume (id from the n8n URL or GET /api/v1/workflows).
# Not a secret -- just an identifier.
# N8N_WORKFLOW_ID=

# ── Workflow Control: Advanced Workflow Update (optional, disabled by default) ────────────────
# Only enable if you intend to use System > Workflow Control's Advanced section (import/compare/
# deploy-as-new-version for a workflow). Never required for normal scraper/campaign config changes.
# ADVANCED_WORKFLOW_UPDATES_ENABLED=true

# ── Admin authentication — REQUIRED in production ─────────────────────────────────────────────
# Signs/verifies the session cookie. Generate with: openssl rand -hex 32
# Required. Changing this value invalidates every existing session (forces re-login).
AUTH_SECRET=

# Optional non-interactive bootstrap of the one admin account. If left unset, visiting /setup
# on first deploy creates the admin account interactively instead (recommended) -- /setup then
# becomes permanently unavailable. Never commit a real value for either of these.
#   ADMIN_PASSWORD_HASH is produced by hashPassword() (src/lib/auth/crypto.ts, scrypt-based) --
#   there is no CLI for it yet; use the /setup page unless you specifically need scripted setup.
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# ── Local CRM data directory (campaigns, admin account, sessions, audit log) ─────────────────
# Set automatically by docker-compose.yml's `environment:` block to the mounted named volume --
# no action needed in this file. Only relevant for local dev (defaults to ./data).
# LOCAL_DATA_DIR=
