# Production runtime environment for the Biggbee CRM container.
# Copy to .env.production (gitignored) and fill in real values -- never commit this file.
# Loaded into the container via docker-compose.yml's `env_file:`. No value here is ever
# baked into the Docker image (see Dockerfile / .dockerignore).
#
# This mirrors .env.example (used for local dev) -- see that file's comments for the full
# walkthrough on obtaining each value. Only the values that actually matter in production
# are listed here; everything else keeps its documented default/optional behavior.

# ── Data source ──────────────────────────────────────────────────────────────
# Production should read the real spreadsheet, not sample data.
DATA_MODE=sheets

# ── Google Sheets (service account) — REQUIRED in production ────────────────
# GOOGLE_PRIVATE_KEY must keep its \n escapes exactly as they appear in the service account's
# JSON key file -- the app converts them back to real newlines at runtime. Quote the value.
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=

# ── n8n automation (webhooks) — REQUIRED in production ───────────────────────
# The CRM only triggers workflows and displays status; all business logic stays in n8n.
N8N_WEBHOOK_RUN_CAMPAIGN=

# Sent as both `Authorization: Bearer <key>` and `X-API-KEY` -- set this once the n8n webhook
# has Header Auth configured (see README → Production Setup Checklist, step 11). Without it the
# webhook is unauthenticated.
N8N_API_KEY=

# ── n8n automation (webhooks) — optional, stay "Not connected" in the UI until set ──
# N8N_BASE_URL=
# N8N_WEBHOOK_PAUSE_CAMPAIGN=
# N8N_WEBHOOK_RESUME_CAMPAIGN=
# N8N_WEBHOOK_REFRESH_KB=
# N8N_WEBHOOK_RETRY_FAILED=
# N8N_WEBHOOK_STATUS=
# N8N_WEBHOOK_SYNC=

# ── Optional: override sheet tab names if the spreadsheet uses different ones ──
# SHEET_TAB_LEADS=Leads
# SHEET_TAB_LEAD_MEMORY=Lead_Memory
# SHEET_TAB_DEMO_LIBRARY=Demo_Library
# SHEET_TAB_ERRORS=Errors
# SHEET_TAB_KB_CACHE=KB_Cache
# SHEET_TAB_UNKNOWN_SENDERS=Unknown_Senders
