# Deploy-orchestration variables for docker-compose.yml's ${...} references.
# Copy to .env.deploy (gitignored) and fill in with values read from the REAL Traefik
# container/network -- do not guess these. See docker-compose.yml's header comment for the
# inspection commands to run, or Task 1 of the deployment runbook.
#
# Used explicitly via: docker compose --env-file .env.deploy ...
# (deliberately NOT named ".env" so `next dev`/`next build` never load it by accident)

# Name of Traefik's existing external docker network, e.g. from `docker network ls`.
TRAEFIK_NETWORK=

# Traefik's HTTPS entrypoint name, from its own --entrypoints.<name> startup flag.
# Common convention: websecure
TRAEFIK_ENTRYPOINT=

# Traefik's certificate resolver name, from its --certificatesresolvers.<name> startup flag.
# Common convention: letsencrypt
TRAEFIK_CERT_RESOLVER=

# Public hostname to route to this app.
CRM_HOST=crm.biggbees.com

# Optional: Traefik's plain-HTTP entrypoint name, only needed if you uncomment the
# HTTP->HTTPS redirect router in docker-compose.yml. Common convention: web
# TRAEFIK_WEB_ENTRYPOINT=
