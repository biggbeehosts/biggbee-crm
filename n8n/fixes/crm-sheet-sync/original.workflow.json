        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst jobId = $json.body?.jobId;\nif (jobId) {\n  // On-demand, job-scoped run -- never touches the periodic checkpoint (see Summarize & Checkpoint).\n  return [{ json: { jobId, since: '' } }];\n}\nconst since = staticData.lastCrmSyncAt || '1970-01-01T00:00:00.000Z';\nstaticData._pendingCrmSyncAt = new Date().toISOString();\nreturn [{ json: { since, jobId: '' } }];"
      },
