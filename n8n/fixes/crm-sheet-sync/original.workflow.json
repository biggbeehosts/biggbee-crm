    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst appended = $('Append CRM Row').all().length;\nconst updated = $('Update CRM Row').all().length;\nconst startRunOutput = $('Start Run').first().json;\n// An on-demand, job-scoped run (jobId set) never advances the periodic checkpoint -- it only\n// ever looked at one job's own leads, not \"everything since last checkpoint\", so treating it\n// as a checkpoint update would let the next periodic run silently skip real, unsynced rows.\nif (!startRunOutput.jobId) {\n  staticData.lastCrmSyncAt = staticData._pendingCrmSyncAt;\n}\nreturn [{ json: { inserted: appended, updated, syncedThrough: staticData.lastCrmSyncAt, jobId: startRunOutput.jobId || null } }];"
      },
